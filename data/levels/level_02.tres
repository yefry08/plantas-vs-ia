[resource]
script = ExtResource("1_tpd5n")
number = 2
display_name = "Sol de mañana"
intro_text = "Más carriles, más robots. Los Girasolares te darán energía."
active_lanes = PackedInt32Array(1, 2, 3)
first_wave_delay = 24.0
waves = Array[ExtResource("2_aib7a")]([SubResource("Resource_2lq7d"), SubResource("Resource_fqbei"), SubResource("Resource_6wkqx"), SubResource("Resource_xg06x"), SubResource("Resource_bsgu1")])
unlock_type = "plant"
unlock_id = "nuez_firewall"
skip_seed_select = true
tutorial_steps = [{
"text": "Planta Girasolares: generan energía extra cada 24 s. ¡Planta varios al principio!",
"until": "place:girasolar"
}, {
"text": "Más energía = más defensas. Recoge la energía que sueltan. Si te equivocas, usa la pala para quitar plantas.",
"until": "time:10"
}]
