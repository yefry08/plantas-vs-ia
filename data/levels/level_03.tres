[resource]
script = ExtResource("1_q8pf3")
number = 3
display_name = "Tokens y aliados"
intro_text = "Aparecen los Spambots. Gana tokens y llama a tu IA aliada."
active_lanes = PackedInt32Array(0, 1, 2, 3, 4)
start_sun = 75
start_tokens = 1
sky_sun_interval = 8.0
first_wave_delay = 26.0
waves = Array[ExtResource("2_6nawd")]([SubResource("Resource_7aiuv"), SubResource("Resource_hij7b"), SubResource("Resource_ilbil"), SubResource("Resource_0bqj5"), SubResource("Resource_ba1yj"), SubResource("Resource_etu6v")])
unlock_type = "plant"
unlock_id = "tokenizadora"
skip_seed_select = true
tutorial_steps = [{
"text": "Destruir robots suelta Tokens (moneda simbólica del juego). Tu IA aliada los usa para ayudarte.",
"until": "tokens:3"
}, {
"text": "¡Ya tienes 3 tokens! Toca la carta Autodestrucción y luego toca un robot.",
"until": "card_used"
}, {
"text": "¡Tu IA aliada te ayudó! Las cartas tienen recarga. Pausa con Esc y acelera con el botón x1/x2.",
"until": "time:9"
}]
